# Fuente auditada desde AUR: calamares 3.4.2-2
# AUR commit: 167151beb537c06cb75c8dbfd409799ba308bb66

_pkgname="calamares"
pkgname="$_pkgname"
pkgver=3.4.2
pkgrel=4
pkgdesc="Distribution-independent installer framework"
url="https://codeberg.org/Calamares/calamares"
license=("GPL-3.0-or-later")
arch=('i686' 'x86_64')
options=('!debug')

depends=(
  'kcoreaddons'
  'kpmcore'
  'libpwquality'
  'python'
  'python-toml'
  'qt6-declarative'
  'qt6-svg'
  'rsync'
  'squashfs-tools'
  'yaml-cpp'
)
makedepends=(
  'extra-cmake-modules'
  'libglvnd'
  'ninja'
  'qt6-tools'
  'qt6-translations'
)

_pkgext="tar.gz"
source=("$_pkgname-$pkgver.$_pkgext"::"$url/releases/download/v$pkgver/$_pkgname-$pkgver.$_pkgext")
sha256sums=('733bbbb00dc9f84874bd5c22960952f317ea2537565431179fa2152b2fbfdccc')

prepare() {
  # MAOSPIX: agrega "español (Paraguay)" copiando la traducción es_AR,
  # así el idioma del sistema instalado queda en es_PY.UTF-8.
  cd "$srcdir/$_pkgname-$pkgver"
  sed 's/<TS language="es_AR"/<TS language="es_PY"/' \
    lang/calamares_es_AR.ts > lang/calamares_es_PY.ts
  rm -rf lang/python/es_PY
  cp -a lang/python/es_AR lang/python/es_PY
  sed -i '/^set( _tx_complete /s/ es es_AR / es es_AR es_PY /' CMakeLists.txt
  grep -q ' es_AR es_PY ' CMakeLists.txt
  # MAOSPIX: nombre del idioma con mayúscula inicial ("Español (Paraguay)").
  sed -i '/QString englishName = m_locale.languageToString/a\    if ( !languageName.isEmpty() ) { languageName[ 0 ] = languageName[ 0 ].toUpper(); }' \
    src/libcalamares/locale/Translation.cpp
  grep -q 'languageName\[ 0 \].toUpper()' src/libcalamares/locale/Translation.cpp
}

build() {
  local _skip_modules=(
    dracut
    dracutlukscfg
    dummycpp
    dummyprocess
    dummypython
    dummypythonqt
    initramfs
    initramfscfg
    interactiveterminal
    packagechooser
    packagechooserq
    services-openrc
  )

  local _pkgsrc_dir="$srcdir/$_pkgname-$pkgver"
  local _cmake_options=(
    -B build
    -S "$_pkgsrc_dir"
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX='/usr'
    -DCMAKE_INSTALL_LIBDIR='lib'
    -DWITH_QT6=ON
    -DINSTALL_CONFIG=ON
    -DSKIP_MODULES="${_skip_modules[*]}"
    -DBUILD_TESTING=OFF
    -DKDE_INSTALL_BINDIR=/usr/bin
    -DKDE_INSTALL_SBINDIR=/usr/sbin
    -DKDE_INSTALL_LIBDIR=/usr/lib
    -DKDE_INSTALL_LIBEXECDIR=/usr/libexec
    -DKDE_INSTALL_INCLUDEDIR=/usr/include
    -DKDE_INSTALL_LOCALSTATEDIR=/var
    -DKDE_INSTALL_SHAREDSTATEDIR=/usr/share
    -DKDE_INSTALL_DATAROOTDIR=/usr/share
    -DKDE_INSTALL_DATADIR=/usr/share
    -DKDE_INSTALL_LOCALEDIR=/usr/share/locale
    -DKDE_INSTALL_MANDIR=/usr/share/man
    -DKDE_INSTALL_INFODIR=/usr/share/info
    -DKDE_INSTALL_SYSCONFDIR=/etc
    -Wno-dev
  )

  cmake "${_cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
