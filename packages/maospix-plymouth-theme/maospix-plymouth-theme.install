# Deja MAOSPIX como tema de arranque. Sin -R: el initramfs lo regenera
# el hook de mkinitcpio al final de la transacción (o Calamares al instalar).
post_install() {
    plymouth-set-default-theme maospix
}

post_upgrade() {
    post_install
}

pre_remove() {
    [ "$(plymouth-set-default-theme)" = maospix ] && plymouth-set-default-theme spinner || true
}
