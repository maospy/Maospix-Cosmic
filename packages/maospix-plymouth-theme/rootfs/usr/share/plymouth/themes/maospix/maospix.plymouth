[Plymouth Theme]
Name=MAOSPIX
Description=Arranque MAOSPIX: escudo neón sobre azul Maospix (basado en Spinner de Plymouth)
ModuleName=two-step

[two-step]
Font=Adwaita Sans 12
TitleFont=Adwaita Sans Light 30
MonospaceFont=Adwaita Mono 12
ImageDir=/usr/share/plymouth/themes/maospix
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.70
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.70
HorizontalAlignment=.5
VerticalAlignment=.72
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0f1524
BackgroundEndColor=0x0f1524
ProgressBarBackgroundColor=0x28344f
ProgressBarForegroundColor=0x4fd8e8
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Instalando actualizaciones...
SubTitle=No apagues la computadora

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Actualizando el sistema...
SubTitle=No apagues la computadora

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Actualizando firmware...
SubTitle=No apagues la computadora

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Restableciendo el sistema...
SubTitle=No apagues la computadora
